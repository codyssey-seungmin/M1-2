# Backend: copy the values you need into a local .env file.
# Use AI_PROVIDER=openai for the official API, or codyssey for its OpenAI-compatible endpoint.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
# Codyssey only: use its virtual key, not an official OpenAI API key.
CODYSSEY_API_KEY=
CODYSSEY_MODEL=
CODYSSEY_BASE_URL=https://copa.codyssey.kr/v1
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to the JSON value above: path to a local service account key file.
FIREBASE_SERVICE_ACCOUNT_PATH=
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Frontend: these public values will be injected into the static app at build time.
# API_BASE_URL must point to the FastAPI server.
API_BASE_URL=http://localhost:8001
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
